# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: The connection string to your MongoDB Atlas cluster.
MONGODB_URI=""

# JWT_SECRET: Secret phrase for robust token encryption.
JWT_SECRET="supersafesecretkey_for_development_only_please_change"

# CLOUDINARY_URL: Optional cloudinary URL for future image upload scaling
CLOUDINARY_URL=""

